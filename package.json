{
  "name": "geofinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node electron/dev.mjs",
    "build": "vite build",
    "dist": "vite build && electron-builder --linux AppImage --config.directories.output=build/release && electron-builder --win portable --config.directories.output=build/release --config.electronDist=",
    "test": "node --test \"electron/*.test.js\" \"src/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:electron": "vite build && playwright test -c tests/electron",
    "test:electron:headless": "bash tests/electron/headless-sway.sh npm run test:electron"
  },
  "dependencies": {
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  }
}
